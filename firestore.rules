rules_version = '2';

// 잰잇 블로그 스튜디오 Firestore 보안 규칙
// 원칙
//  1) 크레딧 잔액(users.credits)·원장(creditLedger)·주문(orders)·생성기록(generations)은
//     Cloud Functions(Admin SDK)만 쓴다. Admin SDK 는 규칙을 우회하므로 여기서는 클라이언트 쓰기를 전부 막는다.
//  2) 사용자는 자기 데이터만 읽는다. 관리자(custom claim admin == true)는 모두 읽을 수 있다.
//  3) 관리자 클라이언트 쓰기는 상품(creditPackages)에만 허용한다. 잔액 조정은 adminAdjustCredits 함수로만.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsExisting() { return signedIn() && resource.data.uid == request.auth.uid; }

    // ── users/{uid} ───────────────────────────────────
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // 생성은 ensureUserProfile 함수만. 사용자는 표시 이름만 수정 가능.
      allow create, delete: if false;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.updatedAt == request.time;
    }

    // ── creditLedger/{entryId} : 읽기 전용 원장 ──────────
    match /creditLedger/{entryId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if false;
    }

    // ── creditPackages/{packageId} : 공개 상품 목록 ─────
    match /creditPackages/{packageId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['name', 'credits', 'price', 'currency', 'active', 'sortOrder'])
        && request.resource.data.name is string
        && request.resource.data.credits is int && request.resource.data.credits > 0
        && request.resource.data.price is int && request.resource.data.price > 0
        && request.resource.data.currency == 'KRW'
        && request.resource.data.active is bool
        && request.resource.data.sortOrder is int;
      allow delete: if isAdmin();
    }

    // ── orders/{orderId} : 결제 주문 (서버 전용 쓰기) ─────
    match /orders/{orderId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if false;
    }

    // ── generations/{generationId} : AI 생성 기록 (서버 전용 쓰기) ──
    match /generations/{generationId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if false;
    }

    // ── posts/{postId} : 사용자가 저장한 글 ───────────────
    // 저장·수정·삭제는 Cloud Functions(savePost/deletePost)만 — FREE 저장 개수 제한을 서버 트랜잭션으로 정확히 적용하기 위해
    // 클라이언트 직접 쓰기는 모두 거부 (JSON 불러오기로 저장 제한을 우회할 수 없음). 사진은 저장하지 않는다.
    match /posts/{postId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if false;
    }

    // ── styles/{styleId} : 개인화 작성 스타일 (서버만 쓰기, 본인 읽기) ──
    match /styles/{styleId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if false;
    }

    // ── exportGrants/{id} : JSON 내보내기 승인 기록 (서버 전용) ──
    match /exportGrants/{id} {
      allow read, write: if false;
    }

    // ── 운영 데이터 (서버 전용 쓰기, 관리자만 읽기) ──────────────
    // generationMetrics: 생성별 토큰·비용·품질 / opsDaily: 일별 합계
    // accountDeletions: 탈퇴 처리 기록
    match /generationMetrics/{id} { allow read: if isAdmin(); allow write: if false; }
    match /opsDaily/{day} { allow read: if isAdmin(); allow write: if false; }
    match /accountDeletions/{uid} { allow read: if isAdmin(); allow write: if false; }

    // ── config/service : 생성 일시중지·일일 비용 상한 (관리자만) ──
    // config/policy : FREE·PRO 한도, 가입 무료 크레딧 — 화면 안내용으로 누구나 읽기, 관리자만 쓰기 (정수·범위 검증)
    match /config/policy {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['signupBonusCredits', 'freeExportLimit', 'freeSavedPostLimit', 'freeStyleLimit', 'proSavedPostLimit', 'proStyleLimit', 'updatedAt', 'updatedBy'])
        && (!('signupBonusCredits' in request.resource.data) || request.resource.data.signupBonusCredits is int && request.resource.data.signupBonusCredits >= 0 && request.resource.data.signupBonusCredits <= 100)
        && (!('freeExportLimit' in request.resource.data) || request.resource.data.freeExportLimit is int && request.resource.data.freeExportLimit >= 0 && request.resource.data.freeExportLimit <= 1000)
        && (!('freeSavedPostLimit' in request.resource.data) || request.resource.data.freeSavedPostLimit is int && request.resource.data.freeSavedPostLimit >= 0 && request.resource.data.freeSavedPostLimit <= 1000)
        && (!('freeStyleLimit' in request.resource.data) || request.resource.data.freeStyleLimit is int && request.resource.data.freeStyleLimit >= 0 && request.resource.data.freeStyleLimit <= 50)
        && (!('proSavedPostLimit' in request.resource.data) || request.resource.data.proSavedPostLimit is int && request.resource.data.proSavedPostLimit >= 1 && request.resource.data.proSavedPostLimit <= 100000)
        && (!('proStyleLimit' in request.resource.data) || request.resource.data.proStyleLimit is int && request.resource.data.proStyleLimit >= 1 && request.resource.data.proStyleLimit <= 200);
    }
    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && docId == 'service'
        && request.resource.data.keys().hasOnly(['generationEnabled', 'pauseMessage', 'dailyCostLimitUsd', 'accessMode', 'allowedEmails', 'updatedAt', 'updatedBy'])
        && (!('accessMode' in request.resource.data) || request.resource.data.accessMode in ['open', 'allowlist'])
        && (!('allowedEmails' in request.resource.data) || request.resource.data.allowedEmails is list && request.resource.data.allowedEmails.size() <= 200)
        && (!('generationEnabled' in request.resource.data) || request.resource.data.generationEnabled is bool)
        && (!('pauseMessage' in request.resource.data) || request.resource.data.pauseMessage is string && request.resource.data.pauseMessage.size() <= 200)
        && (!('dailyCostLimitUsd' in request.resource.data) || request.resource.data.dailyCostLimitUsd is number && request.resource.data.dailyCostLimitUsd >= 0);
    }

    // ── signupGrants/{emailHash} : 가입 보너스 이력 (서버 전용, 비공개) ──
    match /signupGrants/{key} {
      allow read, write: if false;
    }

    // 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
