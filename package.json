{
  "name": "jaeinit-blog-studio",
  "private": true,
  "version": "0.1.0",
  "description": "잰잇 블로그 스튜디오 SaaS (Firebase)",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-jaeinit --import=./.emulator-data --export-on-exit",
    "emulators:clean": "firebase emulators:start --project demo-jaeinit",
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test:unit": "npm --prefix functions run test:unit",
    "test:emu": "firebase emulators:exec --project demo-jaeinit --only auth,firestore,functions \"node --test --test-concurrency=1 tests/rules/*.test.mjs functions/test/integration/*.test.js\"",
    "test": "npm run test:unit && npm run test:web && npm run test:security && npm run test:emu && npm run staging-check:emu",
    "seed": "node scripts/seed.mjs",
    "set-admin": "node scripts/set-admin.mjs",
    "test:security": "npm run build && node --test tests/security/*.test.mjs",
    "test:live": "npm --prefix functions run test:live",
    "test:e2e": "node tests/e2e/smoke.cjs",
    "test:live:check": "npm --prefix functions run test:live:check",
    "benchmark": "node scripts/live-benchmark.mjs",
    "cost-report": "node scripts/cost-report.mjs",
    "build:staging": "npm --prefix web run build:staging",
    "preflight:staging": "node scripts/preflight.mjs staging",
    "preflight:prod": "node scripts/preflight.mjs prod",
    "deploy:staging": "node scripts/preflight.mjs staging && npm run build:staging && firebase deploy --project staging --only firestore,functions,hosting",
    "staging-check": "node scripts/staging-check.mjs",
    "staging-check:emu": "firebase emulators:exec --project demo-jaeinit --only auth,firestore,functions \"node scripts/staging-check.mjs --emulator\"",
    "migrate:photos": "node scripts/migrate-remove-photos.mjs",
    "test:web": "node --test tests/web/*.test.mjs",
    "policy": "node scripts/policy.mjs",
    "test-member": "node scripts/test-member.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0"
  }
}
