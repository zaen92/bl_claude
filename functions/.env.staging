# 스테이징 프로젝트 전용 설정 (firebase use --add 에서 별칭을 "staging" 으로 지정했을 때 자동 적용)
# 비밀값 금지 — Anthropic 키는 스테이징 프로젝트의 Secret Manager 에 "개발용(jaeinit-staging 워크스페이스)" 키로 등록
ACCESS_MODE=allowlist
DAILY_COST_LIMIT_USD=10
DAILY_GENERATION_LIMIT=20
RATE_LIMIT_PER_MINUTE=3
# App Check 설정을 마친 뒤 true 로 바꾸고 다시 배포 (docs/APP_CHECK.md)
ENFORCE_APP_CHECK=false
