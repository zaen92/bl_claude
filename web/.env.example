# Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정)
# Firebase Hosting 에 배포하면 /__/firebase/init.json 에서 자동으로 읽으므로 비워둬도 됩니다.
# 이 값들은 공개되어도 되는 식별자이며 비밀키가 아닙니다. (Claude/네이버/토스 키는 절대 여기에 넣지 마세요)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 로컬 에뮬레이터 사용 여부 (npm run dev 기본값 true, build 기본값 false)
# VITE_USE_EMULATORS=true

# App Check (docs/APP_CHECK.md) — reCAPTCHA Enterprise 사이트 키. 비우면 App Check 미사용.
# VITE_APPCHECK_SITE_KEY=
# 개발용 디버그 토큰 (Firebase 콘솔 > App Check > 앱 > 디버그 토큰 관리 에 등록한 값)
# VITE_APPCHECK_DEBUG_TOKEN=
